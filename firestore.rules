rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (
          (request.auth.token.email == "ahm.atya@gmail.com") ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isStaff() {
      return isAuthenticated() && 
        (
          isAdmin() ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'cashier', 'captain'])
        );
    }
    
    function isCaptain() {
      return isAuthenticated() && 
        (
          isAdmin() ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'captain')
        );
    }

    function isCashier() {
      return isAuthenticated() && 
        (
          isAdmin() ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'cashier')
        );
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() >= 0 && data.email.size() < 150 &&
             data.role in ['admin', 'cashier', 'captain', 'customer'] &&
             data.createdAt is string;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'order']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.order is number;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['categoryId', 'name', 'price', 'isAvailable']) &&
             data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 150 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             data.price is number && data.price >= 0 &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
             data.isAvailable is bool;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['tableNumber', 'items', 'status', 'totalAmount', 'createdAt', 'createdBy', 'type']) &&
             data.tableNumber is string && data.tableNumber.size() > 0 && data.tableNumber.size() < 50 &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100)) &&
             (!('customerMobile' in data) || (data.customerMobile is string && data.customerMobile.size() <= 20)) &&
             data.items is list && data.items.size() > 0 && data.items.size() < 100 &&
             data.status in ['pending', 'confirmed', 'preparing', 'ready', 'served', 'completed', 'cancelled'] &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.createdAt is string &&
             (!('confirmedAt' in data) || (data.confirmedAt is string)) &&
             data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() < 100 &&
             data.type in ['customer', 'captain'];
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['tableNumber', 'amount', 'method', 'status', 'createdAt', 'createdBy']) &&
             data.tableNumber is string && data.tableNumber.size() > 0 &&
             data.amount is number && data.amount > 0 &&
             data.method in ['cash', 'mobile_wallet', 'instapay'] &&
             (!('walletProvider' in data) || data.walletProvider is string) &&
             (!('proofImageUrl' in data) || data.proofImageUrl is string) &&
             data.status in ['pending', 'verified', 'rejected'] &&
             data.createdAt is string &&
             data.createdBy is string;
    }

    function isValidSettings(data) {
      return (!('walletNumber' in data) || data.walletNumber is string) &&
             (!('instapayNumber' in data) || data.instapayNumber is string) &&
             (!('instapayLink' in data) || data.instapayLink is string);
    }

    function isValidShift(data) {
      return data.keys().hasAll(['startTime', 'startedBy', 'status']) &&
             data.startTime is string &&
             data.startedBy is string &&
             data.status in ['open', 'closed'] &&
             (!('endTime' in data) || data.endTime == null || data.endTime is string) &&
             (!('endedBy' in data) || data.endedBy == null || data.endedBy is string) &&
             (!('cashCollected' in data) || data.cashCollected == null || data.cashCollected is number) &&
             (!('expectedCash' in data) || data.expectedCash == null || data.expectedCash is number) &&
             (!('totalSales' in data) || data.totalSales == null || data.totalSales is number) &&
             (!('ordersCount' in data) || data.ordersCount == null || data.ordersCount is number);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && 
                    ((isOwner(userId) && request.resource.data.role == 'customer') || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && 
                    ((isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin());
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCategory(request.resource.data);
      allow update: if isAdmin() && isValidCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow create: if isAdmin() && isValidMenuItem(request.resource.data);
      allow update: if isAdmin() && isValidMenuItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.createdBy == request.auth.uid));
      allow create: if isAuthenticated() && isValidOrder(request.resource.data) && 
                    (request.resource.data.createdBy == request.auth.uid);
      allow update: if (isStaff() && isValidOrder(request.resource.data)) || 
                    (isAuthenticated() && resource.data.createdBy == request.auth.uid && 
                     resource.data.status == 'pending' && isValidOrder(request.resource.data));
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow update: if isAdmin() && (!exists(/databases/$(database)/documents/settings/$(settingId)) || isValidSettings(request.resource.data));
      allow create: if isAdmin() && isValidSettings(request.resource.data);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.createdBy == request.auth.uid));
      allow create: if isAuthenticated() && isValidPayment(request.resource.data) && 
                    (request.resource.data.createdBy == request.auth.uid) &&
                    (request.resource.data.status == 'pending');
      allow update: if isStaff() && isValidPayment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /shifts/{shiftId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidShift(request.resource.data);
      allow update: if isStaff() && isValidShift(request.resource.data);
      allow delete: if isAdmin();
    }

    match /inventoryItems/{itemId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /inventoryTransactions/{transactionId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /staffAccounts/{staffId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}